import json
from pathlib import Path

import numpy as np
import pandas as pd
import requests

LATITUDE = -7.250445
LONGITUDE = 112.768845
YEARS = list(range(2016, 2026))
PARAMS = ["T2M", "T2M_MAX", "T2M_MIN", "QV2M", "PRECTOTCORR"]
RAW_DIR = Path("data/raw")
PROCESSED_DIR = Path("data/processed")


def fetch_daily_nasa_power(year: int, lat: float, lon: float, params: list[str]) -> pd.DataFrame:
    """Download NASA POWER daily data for one year and return a DataFrame."""
    start = f"{year}0101"
    end = f"{year}1231"
    url = "https://power.larc.nasa.gov/api/temporal/daily/point"

    payload = {
        "parameters": ",".join(params),
        "community": "RE",
        "latitude": lat,
        "longitude": lon,
        "start": start,
        "end": end,
        "format": "JSON",
        "time-standard": "UTC",
    }

    response = requests.get(url, params=payload, timeout=180)
    response.raise_for_status()
    data = response.json()

    parameter_block = data.get("properties", {}).get("parameter", {})
    if not parameter_block:
        raise ValueError(f"No parameter data returned for year {year}.")

    records = []
    for date_key in sorted(next(iter(parameter_block.values())).keys()):
        record = {"date": pd.to_datetime(date_key, format="%Y%m%d")}
        for param in params:
            value = parameter_block.get(param, {}).get(date_key)
            record[param] = value
        records.append(record)

    df = pd.DataFrame(records)
    if df.empty:
        raise ValueError(f"No daily records extracted for year {year}.")

    df = df.sort_values("date").reset_index(drop=True)
    return df


def validate_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    """Check missing values, invalid numerics, and duplicate dates."""
    numeric_cols = [c for c in PARAMS if c in df.columns]

    # Convert to numeric while preserving the original structure
    for col in numeric_cols:
        df[col] = pd.to_numeric(df[col], errors="coerce")

    duplicate_dates = int(df["date"].duplicated().sum())
    null_report = df.isna().sum().to_dict()
    invalid_count = int(df[numeric_cols].isna().sum().sum())

    validation = pd.DataFrame(
        [{
            "duplicate_dates": duplicate_dates,
            "missing_cells": int(df.isna().sum().sum()),
            "null_by_column": json.dumps(null_report),
            "invalid_numeric_values": invalid_count,
            "date_min": df["date"].min(),
            "date_max": df["date"].max(),
        }]
    )
    return validation


def build_monthly_summary(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df["month"] = df["date"].dt.to_period("M").astype(str)
    monthly = (
        df.groupby("month")
        .agg(
            mean_temperature_c=("T2M", "mean"),
            max_temperature_c=("T2M_MAX", "mean"),
            min_temperature_c=("T2M_MIN", "mean"),
            total_precipitation_mm=("PRECTOTCORR", "sum"),
            rain_days_ge_1mm=("PRECTOTCORR", lambda s: int((s >= 1).sum())),
            average_humidity_gkg=("QV2M", "mean"),
        )
        .reset_index()
        .rename(columns={"month": "month"})
    )
    return monthly


def build_annual_summary(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    df["year"] = df["date"].dt.year
    annual = (
        df.groupby("year")
        .agg(
            mean_temperature_c=("T2M", "mean"),
            max_temperature_c=("T2M_MAX", "max"),
            min_temperature_c=("T2M_MIN", "min"),
            total_precipitation_mm=("PRECTOTCORR", "sum"),
            rain_days_ge_1mm=("PRECTOTCORR", lambda s: int((s >= 1).sum())),
            average_humidity_gkg=("QV2M", "mean"),
        )
        .reset_index()
    )
    return annual


def save_outputs(all_df: pd.DataFrame, raw_dir: Path, processed_dir: Path):
    raw_dir.mkdir(parents=True, exist_ok=True)
    processed_dir.mkdir(parents=True, exist_ok=True)

    for year in YEARS:
        year_df = all_df[all_df["date"].dt.year == year].copy()
        year_df = year_df.sort_values("date").reset_index(drop=True)
        output_path = raw_dir / f"power_daily_{year}.csv"
        year_df.to_csv(output_path, index=False)

    combined_path = processed_dir / "combined_daily_data.csv"
    all_df.to_csv(combined_path, index=False)

    monthly = build_monthly_summary(all_df)
    annual = build_annual_summary(all_df)
    monthly_path = processed_dir / "monthly_summary.csv"
    annual_path = processed_dir / "annual_summary.csv"
    monthly.to_csv(monthly_path, index=False)
    annual.to_csv(annual_path, index=False)

    validation = validate_dataframe(all_df)
    validation_path = processed_dir / "validation_report.csv"
    validation.to_csv(validation_path, index=False)


if __name__ == "__main__":
    raw_dir = RAW_DIR
    processed_dir = PROCESSED_DIR

    rows = []
    for year in YEARS:
        df = fetch_daily_nasa_power(year, LATITUDE, LONGITUDE, PARAMS)
        rows.append(df)

    all_df = pd.concat(rows, ignore_index=True)
    all_df = all_df.sort_values("date").reset_index(drop=True)

    # Basic cleaning
    all_df["date"] = pd.to_datetime(all_df["date"])
    all_df = all_df.drop_duplicates(subset=["date"], keep="last")
    for col in PARAMS:
        all_df[col] = pd.to_numeric(all_df[col], errors="coerce")

    # Save raw per-year CSVs and processed outputs
    save_outputs(all_df, raw_dir, processed_dir)

    print(f"Downloaded and processed {len(all_df)} daily records from {YEARS[0]} to {YEARS[-1]}.")
    print(f"Files saved to: {raw_dir} and {processed_dir}")
